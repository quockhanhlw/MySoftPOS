<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F8FAFC"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/merchant_mgmt_ripple"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="#DBEAFE"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baseline_person_24"
                    app:tint="#2563EB" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0F172A"
                    android:textSize="@dimen/merchant_dialog_item_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#475569"
                    android:textSize="@dimen/merchant_dialog_item_body_size" />

                <TextView
                    android:id="@+id/tvAccountUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#334155"
                    android:textSize="@dimen/merchant_dialog_item_body_size" />

                <TextView
                    android:id="@+id/tvAccountPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#334155"
                    android:textSize="@dimen/merchant_dialog_item_body_size" />

                <TextView
                    android:id="@+id/tvHostStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_host_status_missing"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/user_mgmt_host_status_missing"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEF2FF"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditAccount"
                    style="@style/Widget.MySoftPOS.MerchantActionIcon.Edit"
                    android:contentDescription="@string/common_edit"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetPasswordAccount"
                    style="@style/Widget.MySoftPOS.MerchantActionIcon.Edit"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/user_mgmt_reset_password"
                    app:icon="@drawable/ic_lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAccount"
                    style="@style/Widget.MySoftPOS.MerchantActionIcon.Delete"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/common_delete"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAccountConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#EEF2FF"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="#334155"
            android:textSize="@dimen/merchant_dialog_item_body_size" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


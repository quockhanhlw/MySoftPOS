<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/swipeActions"
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnSwipeEdit"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="#0EA5E9"
            android:contentDescription="@string/testsuite_swipe_edit"
            android:padding="16dp"
            android:src="@drawable/ic_edit"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnSwipeDelete"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="#EF4444"
            android:contentDescription="@string/testsuite_swipe_delete"
            android:padding="16dp"
            android:src="@drawable/ic_delete"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewAccent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#3B82F6" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">

                <CheckBox
                    android:id="@+id/cbSelect"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:buttonTint="#0F172A"
                    android:scaleX="1.0"
                    android:scaleY="1.0"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    tools:text="Magstripe (Swipe)" />

                <TextView
                    android:id="@+id/tvDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    tools:text="Tap to configure &amp; select" />
            </LinearLayout>

            <TextView
                android:id="@+id/chipBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pill_neutral"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="022" />

            <ImageView
                android:id="@+id/ivEdit"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

